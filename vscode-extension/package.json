{
  "name": "rustzap",
  "displayName": "RustZAP",
  "description": "Run RustZAP static analysis and DAST scans from VS Code",
  "version": "0.1.0",
  "publisher": "rustzap",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "security",
    "sast",
    "dast",
    "rustzap",
    "owasp"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "rustzap.analyzeWorkspace",
        "title": "RustZAP: Analyze Workspace",
        "icon": "$(search)"
      },
      {
        "command": "rustzap.scanUrl",
        "title": "RustZAP: Scan URL",
        "icon": "$(globe)"
      },
      {
        "command": "rustzap.clearFindings",
        "title": "RustZAP: Clear Findings",
        "icon": "$(clear-all)"
      },
      {
        "command": "rustzap.showOutput",
        "title": "RustZAP: Show Output",
        "icon": "$(output)"
      },
      {
        "command": "rustzap.openFinding",
        "title": "Open Finding"
      },
      {
        "command": "rustzap.showFindingDetails",
        "title": "RustZAP: Show Finding Details"
      },
      {
        "command": "rustzap.showReportSummary",
        "title": "RustZAP: Show Report Summary"
      },
      {
        "command": "rustzap.openLastReport",
        "title": "RustZAP: Open Last Report (JSON)",
        "icon": "$(json)"
      },
      {
        "command": "rustzap.focusFindings",
        "title": "RustZAP: Focus Findings"
      },
      {
        "command": "rustzap.scanAttackPlanEntry",
        "title": "RustZAP: Scan Attack Plan Target"
      }
    ],
    "views": {
      "rustzap": [
        {
          "id": "rustzap.findings",
          "name": "Findings"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "rustzap",
          "title": "RustZAP",
          "icon": "media/shield.svg"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "rustzap.analyzeWorkspace",
          "when": "view == rustzap.findings",
          "group": "navigation@1"
        },
        {
          "command": "rustzap.scanUrl",
          "when": "view == rustzap.findings",
          "group": "navigation@2"
        },
        {
          "command": "rustzap.clearFindings",
          "when": "view == rustzap.findings",
          "group": "navigation@3"
        },
        {
          "command": "rustzap.openLastReport",
          "when": "view == rustzap.findings",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "rustzap.openFinding",
          "when": "view == rustzap.findings && viewItem == finding",
          "group": "inline@1"
        },
        {
          "command": "rustzap.showFindingDetails",
          "when": "view == rustzap.findings && viewItem == finding",
          "group": "inline@2"
        },
        {
          "command": "rustzap.scanAttackPlanEntry",
          "when": "view == rustzap.findings && viewItem == attackPlan",
          "group": "inline"
        }
      ]
    },
    "configuration": {
      "title": "RustZAP",
      "properties": {
        "rustzap.path": {
          "type": "string",
          "default": "",
          "description": "Path to the rustzap executable. When empty, PATH and local cargo build are tried."
        },
        "rustzap.analyze.tools": {
          "type": "string",
          "default": "native",
          "description": "Comma-separated analyze tools (semgrep,trivy,gitleaks,native,checkov)."
        },
        "rustzap.analyze.onSave": {
          "type": "boolean",
          "default": false,
          "description": "Run analyze on save (off by default)."
        },
        "rustzap.scan.passiveOnly": {
          "type": "boolean",
          "default": true,
          "description": "Use --passive-only for DAST scans (recommended)."
        },
        "rustzap.scan.depth": {
          "type": "number",
          "default": 1,
          "minimum": 1,
          "maximum": 20,
          "description": "Spider depth for DAST scans."
        },
        "rustzap.scan.plugins": {
          "type": "string",
          "default": "",
          "description": "Active plugin list for scans when passiveOnly is false."
        },
        "rustzap.scan.insecure": {
          "type": "boolean",
          "default": false,
          "description": "Skip TLS certificate verification during scans."
        },
        "rustzap.problems.infoSeverity": {
          "type": "string",
          "enum": ["information", "hint"],
          "default": "information",
          "description": "How info-level findings appear in Problems (information shows by default; hint is often hidden)."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node ./out/test/runTest.js",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.4.1",
    "mocha": "^8.1.3",
    "typescript": "^5.5.0"
  }
}
