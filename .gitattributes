# Keep hook and shell scripts LF so Git for Windows bash can execute them.
.githooks/** text eol=lf
scripts/**/*.sh text eol=lf
scripts/**/*.cmd text eol=crlf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Packaging scripts that Windows tools consume
*.iss text eol=crlf
node_modules
node_modules/**